{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bam.dev/schema/curriculum.schema.json",
  "title": "BAM.dev curriculum",
  "type": "object",
  "required": ["schemaVersion", "product", "categories", "languages", "courses", "lessons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "BAM.dev" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "sample", "planned"] },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "status", "accent", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "sample", "planned"] },
          "accent": { "enum": ["javascript", "html", "css", "java"] },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "categoryId", "languageId", "name", "shortName", "status", "accent", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "categoryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "languageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "sample", "planned"] },
          "accent": { "enum": ["javascript", "html", "css", "java"] },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "courseId", "languageId", "order", "slug", "title", "summary", "essentialQuestion", "objectives", "estimatedMinutes", "conceptIds", "contentFile", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "courseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "languageId": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "essentialQuestion": { "type": "string", "minLength": 1 },
          "answerHeading": { "type": "string", "minLength": 1 },
          "archivedFromCatalog": { "type": "boolean" },
          "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "conceptIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" } },
          "contentFile": { "type": "string", "pattern": "^content/lessons/.+\\.md$" },
          "source": {
            "type": "object",
            "required": ["kind", "verifiedAt"],
            "properties": {
              "kind": { "enum": ["user-authored", "bam-authored"] },
              "verifiedAt": { "type": "string", "format": "date" },
              "originalPath": { "type": "string", "pattern": "^(?:profile/|wiki/학습자료/밤데브 학습문서/).+\\.md$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "importedAt": { "type": "string", "format": "date" },
              "importMode": { "enum": ["copy", "excerpt", "derived"] }
            },
            "allOf": [
              { "if": { "required": ["originalPath"] }, "then": { "required": ["sha256", "importedAt", "importMode"] } },
              { "if": { "required": ["sha256"] }, "then": { "required": ["originalPath", "importedAt", "importMode"] } },
              { "if": { "required": ["importedAt"] }, "then": { "required": ["originalPath", "sha256", "importMode"] } },
              { "if": { "required": ["importMode"] }, "then": { "required": ["originalPath", "sha256", "importedAt"] } }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
