{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bam.dev/schema/curriculum.schema.json",
  "title": "BAM.dev curriculum",
  "type": "object",
  "required": ["schemaVersion", "product", "languages", "lessons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "BAM.dev" },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "status", "accent", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "sample", "planned"] },
          "accent": { "enum": ["javascript", "html", "css", "java"] },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "languageId", "order", "slug", "title", "summary", "essentialQuestion", "objectives", "estimatedMinutes", "conceptIds", "contentFile", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "languageId": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "essentialQuestion": { "type": "string", "minLength": 1 },
          "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "conceptIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" } },
          "contentFile": { "type": "string", "pattern": "^content/lessons/.+\\.md$" },
          "source": {
            "type": "object",
            "required": ["kind", "verifiedAt"],
            "properties": {
              "kind": { "enum": ["user-authored", "bam-authored"] },
              "verifiedAt": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
