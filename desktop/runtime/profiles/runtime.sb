(version 1)
(deny default)

(allow file-read*
  (subpath (param "JDK_ROOT"))
  (subpath (param "RUNNER_ROOT"))
  (subpath (param "CLASSES_ROOT"))
  (literal "/")
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (literal "/dev/fd/3")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/private/etc/localtime")
  (literal "/Library/Preferences/Logging/com.apple.diagnosticd.filter.plist")
  (subpath "/private/var/db/timezone"))

(allow file-read-metadata
  (literal "/etc")
  (literal "/tmp")
  (literal "/var")
  (literal "/private")
  (literal "/Library")
  (literal (param "METADATA_ANCESTOR_01"))
  (literal (param "METADATA_ANCESTOR_02"))
  (literal (param "METADATA_ANCESTOR_03"))
  (literal (param "METADATA_ANCESTOR_04"))
  (literal (param "METADATA_ANCESTOR_05"))
  (literal (param "METADATA_ANCESTOR_06"))
  (literal (param "METADATA_ANCESTOR_07"))
  (literal (param "METADATA_ANCESTOR_08"))
  (literal (param "METADATA_ANCESTOR_09"))
  (literal (param "METADATA_ANCESTOR_10"))
  (literal (param "METADATA_ANCESTOR_11"))
  (literal (param "METADATA_ANCESTOR_12"))
  (literal (param "METADATA_ANCESTOR_13"))
  (literal (param "METADATA_ANCESTOR_14"))
  (literal (param "METADATA_ANCESTOR_15"))
  (literal (param "METADATA_ANCESTOR_16"))
  (literal (param "METADATA_ANCESTOR_17"))
  (literal (param "METADATA_ANCESTOR_18"))
  (literal (param "METADATA_ANCESTOR_19"))
  (literal (param "METADATA_ANCESTOR_20"))
  (literal (param "METADATA_ANCESTOR_21"))
  (literal (param "METADATA_ANCESTOR_22"))
  (literal (param "METADATA_ANCESTOR_23"))
  (literal (param "METADATA_ANCESTOR_24"))
  (literal (param "METADATA_ANCESTOR_25"))
  (literal (param "METADATA_ANCESTOR_26"))
  (literal (param "METADATA_ANCESTOR_27"))
  (literal (param "METADATA_ANCESTOR_28"))
  (literal (param "METADATA_ANCESTOR_29"))
  (literal (param "METADATA_ANCESTOR_30"))
  (literal (param "METADATA_ANCESTOR_31"))
  (literal (param "METADATA_ANCESTOR_32")))
(allow file-write-data (literal "/dev/fd/3"))
(allow process-exec (literal (param "EXECUTABLE")))
(allow file-map-executable)
(allow dynamic-code-generation)
(allow sysctl-read)
(allow process-info* (target self))
(allow signal (target self))
(allow mach-lookup
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.SystemConfiguration.configd"))
